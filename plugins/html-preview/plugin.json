    { "key": "barMinimize", "title": "透明表示のとき最小化する", "type": "bool" },
    { "key": "barPosition", "title": "透明表示のボタンの位置", "type": "choice", "options": ["右下", "右上", "左下", "左上"], "default": "右下" }
