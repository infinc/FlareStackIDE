    { "key": "color3", "title": "深さ3の色", "type": "color", "default": "#4FA8F0" },
    { "key": "matchColor", "title": "対応する括弧の背景色", "type": "color", "default": "#8E8E93" },
    { "key": "unmatched", "title": "対応のない括弧を赤くする", "type": "bool", "default": "true" }
